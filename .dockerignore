# Version control
.git/
.gitignore

# Gradle / build outputs (regenerated inside the image)
.gradle/
build/
target/

# Frontend artifacts (regenerated by pnpmBuild inside the image)
frontend/node_modules/
frontend/dist/

# IDE / tooling
.idea/
*.iml
.vscode/

# Docs and local-only material
*.md
docs/
prompts/
assets/

# Local env / secrets — never bake into the image
*.env
.env
gradle.properties
