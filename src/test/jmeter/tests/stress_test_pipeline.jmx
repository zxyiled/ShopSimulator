      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Stress Ram-up " enabled="true">
        <stringProp name="TestPlan.comments">Gradually increase the load until you reach the system&apos;s breaking point
— where response times skyrocket or errors occur</stringProp>
        <intProp name="ThreadGroup.num_threads">400</intProp>
        <intProp name="ThreadGroup.ramp_time">120</intProp>
        <longProp name="ThreadGroup.duration">600</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
