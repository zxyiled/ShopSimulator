          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="PATCH Products - Stress" enabled="true">
          <stringProp name="HTTPSampler.path">/api/products/STRESS01/stock</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
